{
  "schemaVersion": 1,
  "id": "mcendgame",
  "version": "${version}",
  "name": "MCEndgame",
  "description": "MCEndgame is a Minecraft mod that aims to make Minecraft's endgame more engaging through repeatable dungeon content, meaningful gear progression, and ARPG-inspired itemization.",
  "authors": [
    "maucon",
    "Moewe342"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/mcendgame/",
    "sources": "https://github.com/maucon/MCEndgame"
  },
  "license": "LGPL-3.0",
  "icon": "assets/mcendgame/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "de.fuballer.mcendgame.main.MCEndgame",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "de.fuballer.mcendgame.client.MCEndgameClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "de.fuballer.mcendgame.client.MCEndgameDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "mcendgame.mixins.json",
    {
      "config": "mcendgame.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "mcendgame.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.160.5+26.3",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "geckolib": "~5.5.7"
  }
}