{
  "schemaVersion": 1,
  "id": "mcendgame",
  "version": "${version}",
  "name": "MCEndgame",
  "description": "MCEndgame is a Minecraft Mod that enhances the endgame experience by introducing new levels of progression.",
  "authors": [
    "maucon",
    "Moewe342"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/mcendgame/",
    "sources": "https://github.com/maucon/MCEndgame-fabric"
  },
  "license": "MIT",
  "icon": "assets/mcendgame/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "de.fuballer.mcendgame.main.MCEndgame",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "de.fuballer.mcendgame.client.MCEndgameClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "de.fuballer.mcendgame.client.MCEndgameDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "mcendgame.mixins.json",
    {
      "config": "mcendgame.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "mcendgame.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "~0.116.13+1.21.1",
    "fabric-language-kotlin": "~1.13.11+kotlin.2.3.21",
    "fantasy": "~0.6.4+1.21",
    "geckolib": "~4.9.2"
  }
}